# Copy to .env for local development (never commit real secrets).

# First admin account (only used when the database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Signs login sessions. Use a long random string in production.
SESSION_SECRET=

# Enables "Generate with AI" and "Import existing SOPs"
ANTHROPIC_API_KEY=

# Where the database and uploaded files live (Railway: mount a volume at /data)
DATA_DIR=./data

# Public address, used in QR codes. Railway sets RAILWAY_PUBLIC_DOMAIN, so this is optional there.
# APP_URL=https://sops.example.com

# Largest upload in MB (videos)
MAX_UPLOAD_MB=1024

# Chromium for PDF export (auto-detected; the Docker image sets this)
# CHROMIUM_PATH=/usr/bin/chromium
