# Copy to .env for local development (never commit real secrets).

# First admin account (only used when the database is empty)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Signs login sessions. Use a long random string in production.
SESSION_SECRET=

# Enables "Generate with AI" and "Import existing SOPs"
ANTHROPIC_API_KEY=

# Where the database and uploaded files live (Railway: mount a volume at /data)
DATA_DIR=./data

# Public address, used in QR codes. Railway sets RAILWAY_PUBLIC_DOMAIN, so this is optional there.
# APP_URL=https://sops.example.com

# Largest upload in MB (videos)
MAX_UPLOAD_MB=1024

# Chromium for PDF export (auto-detected; the Docker image sets this)
# CHROMIUM_PATH=/usr/bin/chromium

# ---- Optional features ----

# Email (review reminders, approvals, re-sign requests)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=sops@yourcompany.com
# SMTP_PASS=
# SMTP_FROM=SOPs <sops@yourcompany.com>

# Keep uploads in an S3-compatible bucket (Railway Bucket, S3, R2, B2, MinIO) instead of the volume
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Speech-to-text for narrated recordings (any one of these)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# TRANSCRIBE_BASE_URL=http://my-whisper-server:8000/v1
# TRANSCRIBE_MODEL=whisper-1
